# Copy to .env for local development. NEVER commit a real .env.
# In staging/production, inject these as real secrets (platform secret
# manager / Docker secrets), never as a checked-in file — see §13.

ENV=development

# --- Database ---------------------------------------------------------
# Request-serving role: NOT the table owner, NOT BYPASSRLS. See §10 and
# scripts/create_roles.sql.
DATABASE_URL=postgresql+asyncpg://app_user:app_password@localhost:5432/aiagentv8
# Migration-owner role, used ONLY by `alembic upgrade`. Never point the
# running app at this URL.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://migrator:migrator_password@localhost:5432/aiagentv8
# Background worker's own distinct role — see app/db/session.py worker_session().
WORKER_DATABASE_URL=postgresql+asyncpg://worker_role:worker_password@localhost:5432/aiagentv8

DB_POOLER_VERIFIED_TRANSACTION_SAFE=false

# --- Auth (buy, don't build — §11) -------------------------------------
# Point these at your chosen provider (Supabase Auth / Clerk / WorkOS).
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=

# --- Credential vault / KMS ---------------------------------------------
# local_dev ONLY for development. Production must use gcp_kms/aws_kms —
# see app/credentials/kms.py.
KMS_PROVIDER=local_dev
LOCAL_DEV_KMS_KEY_DIR=./.local_kms_keys

# --- AI provider (RC-7: refuses to boot in production unless this is true) ---
GEMINI_API_KEY=
GEMINI_BILLING_ENABLED=false

# --- Messaging (RC-1: BYO-Twilio is the default) -----------------------
TWILIO_MODE=byo

# --- Inbound email (RC-3) ------------------------------------------------
INBOUND_EMAIL_DOMAIN=inbound.example.com

# --- Observability -------------------------------------------------------
LOG_LEVEL=INFO
SENTRY_DSN=

# --- Tests (tests/conftest.py) --------------------------------------------
# A sync URL to a THROWAWAY database, connecting as a role that can
# create roles/tables (e.g. the Postgres superuser in CI). Every test
# that needs a live database is skipped if this is unset.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aiagentv8_test
